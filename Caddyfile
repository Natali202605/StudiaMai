# Правила для боевого хостинга (Timeweb / Caddy).
# Закрывает статическую раздачу служебных каталогов /server и /backend.
# Если панель Timeweb подхватывает Caddyfile из корня репозитория — достаточно деплоя.
# Иначе добавьте в панели хостинга правило: путь /server* и /backend* → 404.

{
	# Глобальные опции при необходимости задаёт панель хостинга.
}

:80, :443 {
	@blocked path /server/* /backend/* /server /backend
	respond @blocked 404

	root * .
	file_server
}
