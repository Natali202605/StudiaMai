# Правила для боевого хостинга (Timeweb / Caddy).
# Закрывает статическую раздачу служебных каталогов.
# Если панель не подхватывает Caddyfile — задайте те же пути → 404 вручную.

{
	# Глобальные опции при необходимости задаёт панель хостинга.
}

:80, :443 {
	@blocked path /server/* /backend/* /ops/* /server /backend /ops
	respond @blocked 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Строгий CSP не задаём: на странице inline-скрипты и Яндекс.Формы.
	}

	root * .
	file_server
}
